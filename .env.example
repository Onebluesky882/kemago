# Copy to .env and fill in real values. .env is gitignored — never commit it.

# backend/api-go
PORT=3000
DATABASE_URL=postgres://kemago:kemago@postgres:5432/kemago?sslmode=disable
REDIS_URL=redis://redis:6379
# Generate with: openssl rand -base64 32
JWT_SECRET=

# backend/ws-go
WS_PORT=3001

# Postgres container (docker-compose.yml)
POSTGRES_USER=kemago
POSTGRES_PASSWORD=kemago
POSTGRES_DB=kemago

# --- OTP providers ---
# Active: Resend (email) — see backend/api-go/internal/otp/email_provider.go
RESEND_API_KEY=
# onboarding@resend.dev works without domain verification (Resend's test
# sender) — switch to a verified custom domain before shipping to real users
EMAIL_FROM="Kemago <onboarding@resend.dev>"

# Inactive (built, kept configured for switching back — see main.go):
THAIBULK_SMS_KEY=
THAIBULK_SMS_SECRET=
# Must exactly match a sender name approved in the ThaiBulkSMS dashboard
# (case-sensitive) — see backend/api-go/internal/sms/thaibulksms.go
SMS_SENDER=Demo

SMSMKT_API_KEY=
SMSMKT_SECRET_KEY=
SMSMKT_PROJECT_KEY=
# For SMSMKT's plain send-message API — needs its own NBTC-approved
# sender name, separate from an OTP Project
SMSMKT_SENDER=
