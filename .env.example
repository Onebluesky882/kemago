# Copy to .env and fill in real values. .env is gitignored — never commit it.

THAIBULK_SMS_KEY=
THAIBULK_SMS_SECRET=

# backend/api-go
PORT=3000
DATABASE_URL=postgres://coarea:coarea@postgres:5432/coarea?sslmode=disable
REDIS_URL=redis://redis:6379
# Must exactly match a sender name approved in the ThaiBulkSMS dashboard
# (case-sensitive) — see backend/api-go/internal/sms/thaibulksms.go
SMS_SENDER=Coarea
# Generate with: openssl rand -base64 32
JWT_SECRET=

# backend/ws-go
WS_PORT=3001

# Postgres container (docker-compose.yml)
POSTGRES_USER=coarea
POSTGRES_PASSWORD=coarea
POSTGRES_DB=coarea
