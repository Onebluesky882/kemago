# Copy to .env and fill in real values. .env is gitignored — never commit it.

# PORT/REDIS_URL/JWT_SECRET below are unused leftovers from the original
# backend/api-go (OTP/JWT REST API), deleted in stage-16 — kept in case
# something still reads them, safe to remove once confirmed nothing does.
PORT=3000
REDIS_URL=redis://redis:6379
# Generate with: openssl rand -base64 32
JWT_SECRET=

# backend/api-go (renamed from ws-go in stage-23 — now owns every non-auth
# domain: rooms/posts/comments/likes REST API + the websocket chat hub).
# DATABASE_URL is the same physical Postgres backend/better-auth uses —
# api-go only reads its "user"/"session" tables, never writes them.
WS_PORT=3001
DATABASE_URL=postgres://kemago:kemago@postgres:5432/kemago?sslmode=disable

# Postgres container (docker-compose.yml)
POSTGRES_USER=kemago
POSTGRES_PASSWORD=kemago
POSTGRES_DB=kemago

# --- OTP providers (all unused leftovers from the original, deleted
# backend/api-go — stage-16 moved OTP to backend/better-auth's own
# emailOTP plugin, which reads RESEND_API_KEY/EMAIL_FROM from ITS OWN
# .env file, not this root one. Safe to remove once confirmed unused.) ---
RESEND_API_KEY=
EMAIL_FROM="Kemago <onboarding@resend.dev>"

THAIBULK_SMS_KEY=
THAIBULK_SMS_SECRET=
SMS_SENDER=Demo

SMSMKT_API_KEY=
SMSMKT_SECRET_KEY=
SMSMKT_PROJECT_KEY=
SMSMKT_SENDER=

# --- Stories (photo/video upload, IG-style) — backend/api-go, internal/stories ---
# Optional: if R2_ACCOUNT_ID is unset, api-go still starts and everything
# else works normally — only POST/GET /api/stories* 404. Get these from
# the Cloudflare dashboard: R2 > create a bucket > Manage R2 API Tokens
# (account ID is shown on the R2 overview page, top right).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: a public bucket domain or custom domain (R2 > bucket > Settings
# > Public access) so story media URLs don't need to be re-signed on every
# read. Leave empty to fall back to a 1-hour presigned GET URL per story
# instead — works, just not stable to cache long-term.
R2_PUBLIC_URL=
